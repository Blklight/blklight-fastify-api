# Database
DATABASE_URL=postgresql://user:password@localhost:5432/blklight_api

# JWT - Access Token
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# JWT - Refresh Token
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Auth
MAX_SESSIONS_PER_USER=5

# Signatures (AES-256-GCM encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNATURE_ENCRYPTION_KEY=your-64-char-hex-key-32-bytes-here

# OAuth - GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth - Google (https://console.cloud.google.com/applications/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Redirects
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
EMAIL_DAILY_LIMIT=50
EMAIL_VERIFY_EXPIRES_IN_HOURS=24
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# Feature Flags
# Email verification and password reset (requires: RESEND_API_KEY, EMAIL_FROM, FRONTEND_URL)
FEATURE_EMAIL=false
# GitHub and Google OAuth login (requires: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET)
FEATURE_OAUTH=false
# Persistent email queue processor - runs every 10 minutes (requires: FEATURE_EMAIL=true)
FEATURE_EMAIL_QUEUE=false
# Code execution sandbox for tutorial exercises (disable to skip node:vm overhead)
FEATURE_CODE_SANDBOX=true

# Admin Bootstrap (optional - creates first admin account on seed)
# If both are set, an admin user is created on first seed run
ADMIN_EMAIL=
ADMIN_PASSWORD=
